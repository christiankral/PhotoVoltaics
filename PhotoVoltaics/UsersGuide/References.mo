within PhotoVoltaics.UsersGuide;
class References "References"
  extends Modelica.Icons.References;
  annotation (
    preferredView = "info",
    Documentation(info="<html>
<h4>References</h4>

<table border=\"0\" cellspacing=\"0\" cellpadding=\"2\">
    <tr>
      <td valign=\"top\">[Brkic2019]</td>
      <td valign=\"top\">Jovan Brkic, Muaz Ceran, Mohamed Elmoghazy, Ramazan Kavlak, Anton Haumer, Christian Kral,
      \"<a href=\"https://www.ep.liu.se/ecp/157/004/ecp19157004.pdf\">Open Source PhotoVoltaics Library for Systemic Investigations</a>\",
        <i>13th Modelica Conference 2019</i>, Regensburg, Germany.</td>
    </tr>
    <tr>
      <td valign=\"top\">[Kasten1989]</td>
      <td valign=\"top\">Fritz Kasten, Andrew T. Young,
      \"Revised optical air mass tables and approximation formula\",
        <i>Applied Optics</i>, vol. 28, no. 22, pp. 4735-4738, 1989.</td>
    </tr>
    <tr>
      <td valign=\"top\">[Meinel1976]</td>
      <td valign=\"top\">Aden B. Meinel, Marjorie P. Meinel,
        <i>Applied Solar Energy: An Introduction</i>, Addison-Wesley, Reading, MA, 1976.</td>
    </tr>
    <tr>
      <td valign=\"top\">[Quaschning2015]</td>
      <td valign=\"top\">Volker Quaschning,
        <i>Regenerative Energiesysteme: Technologie &ndash; Berechnung &ndash; Simulation</i>, 9th edition,
        Carl Hanser Verlag, Munich, 2015.</td>
    </tr>
</table>

</html>"));
end References;
